  m_EditorClassIdentifier: 
  id: 2
  steps: 5
  descriptionsRu:
  - "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
  - "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
  - "\u0421\u043F\u0443\u0441\u043A\u0430\u0439\u0441\u044F \u0432 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435
    \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
  - "\u041F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u043D\u0438 \u0431\u043E\u0433\u043E\u043C\u043E\u043B\u0430
    \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
  - "\u041F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u044C\u0441\u044F \u0441 \u043A\u0443\u0431\u0435\u0440\u0430\u043C\u0438
    \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
  - "\u0418\u0437\u0443\u0447\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
    \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
  descriptionsEng:
  - Continue your research
  - Continue your research
  - Go down to the dungeon and continue exploring
  - Jump over the mantis and continue exploring
  - Get to know the cubers and keep exploring
  - Study the items to create and continue the research
