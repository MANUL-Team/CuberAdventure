--- !u!114 &6548424035643889709
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6317675532364504470}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e95f4e3dc194a3d4ca2ef622ce0be4e5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  id: 1
  steps: 9
  descriptionsRu:
  - "\u041D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0441\u044F \u043A \u0410\u0431\u0434\u0443\u043B\u0443
    \u0438 \u0443\u0437\u043D\u0430\u0439 \u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u0445
    \u0438 \u043A\u0440\u0430\u0444\u0442\u0430\u0445."
  - "\u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u043A\u0440\u0430\u0444\u0442\u043E\u0432
    \u0438 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0435\u043C\u044B\u0445 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432
    \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F \u043A \u0414\u044D\u043D\u0443630."
  - "\u041F\u043E\u043C\u043E\u0433\u0438 \u0410\u0431\u0434\u0443\u043B\u0443."
  - "\u041F\u0435\u0440\u0435\u0434\u0430\u0439 \u0441\u043B\u043E\u0432\u0430 \u0410\u0431\u0434\u0443\u043B\u0430
    \u0412\u0438\u0442\u0430\u043B\u0438\u044E \u0438\u0437 \u0411\u043E\u0433\u043E\u043C\u0433\u0440\u0430\u0434\u0430."
  - "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E
    \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0439 \u0410\u0431\u0434\u0443\u043B\u0443
    \u043E \u0431\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0438
    \u0411\u043E\u0433\u043E\u043C\u0433\u0440\u0430\u0434\u0430."
  - "\u0421\u043E\u0431\u0435\u0440\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u044B
    \u0438 \u0441\u043A\u0440\u0430\u0444\u0442\u0438 \u043C\u043E\u0434\u0443\u043B\u0438
    \u0434\u043B\u044F \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u044F
    \u043B\u043E\u0433\u043E\u0432\u0430 \u043F\u0430\u0443\u043A\u043E\u0432. (\u0423\u0440\u043E\u0432\u0435\u043D\u044C
    \u044F\u0434\u0440\u0430 - 4, \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0431\u0440\u043E\u043D\u0438
    - 3, \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043B\u0430\u0437\u0435\u0440\u0430
    - 2)"
  - "\u0423\u0431\u0435\u0439 \u0410\u0434\u043C\u0438\u0440\u0430\u043B\u0430-\u043F\u0430\u0443\u043A\u0430
    \u0432 \u043B\u043E\u0433\u043E\u0432\u0435 \u043F\u0430\u0443\u043A\u043E\u0432."
  - "\u0418\u0434\u0438 \u0432 \u0411\u043E\u0433\u043E\u043C\u0433\u0440\u0430\u0434,
    \u0447\u0442\u043E\u0431\u044B \u0443\u0431\u0438\u0442\u044C \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0443
    \u043F\u0430\u0443\u043A\u043E\u0432."
  - "\u0418\u0434\u0438 \u0432 \u0414\u0435\u0440\u0435\u0432\u043D\u044E \u043A\u0443\u0431\u0435\u0440\u043E\u0432,
    \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
    \u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u0434\u0448\u0435\u043C."
  - "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435 \u0441\u043B\u0435\u0434\u0443\u0435\u0442..."
  descriptionsEng:
  - Head to Abdul and learn about items and crafting.
  - After looking at the possible crafting and tradable items, return to Dan630.
  - Help Abdul.
  - Pass the words of Abdul to Vitaly from Bogomgrad.
  - Go back to the village and tell Abdul about the plight of Bogomgrad.
  - Collect resources and craft modules to destroy the spider lair. (Core level -
    4, Armor level - 3, Laser level - 2)
  - Kill the Spider Admiral in the spider lair.
  - Go to Bogomgrad to kill the Spider Queen.
  - Go to the Village of Cubers to tell about what happened.
  - To be continued...
  mc: {fileID: 6385355962083390757}
  checkMission: {fileID: 5358866965165335344}
