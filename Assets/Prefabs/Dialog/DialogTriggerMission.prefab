--- !u!114 &7603313533023696501
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2390220611799770499}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dece018d637e3184b8a152729f8b12bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 4768290103918382307}
  button: {fileID: 8994443853687079556}
  name: {fileID: 6308428440970532002}
  text: {fileID: 6538978509531910671}
  printText: {fileID: 3104291339819712809}
  namesEng:
  - Dan630
  - Dan630
  - Dan630
  - Dan630
  dialogTextsEng:
  - Hm... I haven't seen you here before, are you new? Do you already know how to
    use your modules? Fine, then you need to learn how to create new ones!
  - The forge has a machine for creating modules in the form of an anvil. In it,
    you can craft any modules that it supports.
  - But keep in mind that you will need resources to craft. They can be bought in
    a store or found in the world.
  - Good luck!
  namesRu:
  - "\u0414\u044D\u043D630"
  - "\u0414\u044D\u043D630"
  - "\u0414\u044D\u043D630"
  - "\u0414\u044D\u043D630"
  dialogTextsRu:
  - "\u0425\u043C... \u042F \u0442\u0435\u0431\u044F \u0440\u0430\u043D\u044C\u0448\u0435
    \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u0432\u0438\u0434\u0435\u043B, \u0442\u044B
    \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439? \u0422\u044B \u0443\u0436\u0435
    \u0443\u043C\u0435\u0435\u0448\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0441\u0432\u043E\u0438 \u043C\u043E\u0434\u0443\u043B\u0438? \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E,
    \u0442\u043E\u0433\u0434\u0430 \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E
    \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
    \u043D\u043E\u0432\u044B\u0435!"
  - "\u0412 \u043A\u0443\u0437\u043D\u0438\u0446\u0435 \u0435\u0441\u0442\u044C \u043C\u0430\u0448\u0438\u043D\u0430
    \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043C\u043E\u0434\u0443\u043B\u0435\u0439
    \u0432 \u0432\u0438\u0434\u0435 \u043D\u0430\u043A\u043E\u0432\u0430\u043B\u044C\u043D\u0438.
    \u0412 \u043D\u0435\u0439 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u043A\u0440\u0430\u0444\u0442\u0438\u0442\u044C
    \u043B\u044E\u0431\u044B\u0435 \u043C\u043E\u0434\u0443\u043B\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043E\u043D\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442."
  - "\u041D\u043E \u0443\u0447\u0442\u0438, \u0447\u0442\u043E \u0434\u043B\u044F
    \u043A\u0440\u0430\u0444\u0442\u0430 \u0442\u0435\u0431\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F
    \u0440\u0435\u0441\u0443\u0440\u0441\u044B. \u0418\u0445 \u043C\u043E\u0436\u043D\u043E
    \u043A\u0443\u043F\u0438\u0442\u044C \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435
    \u0438\u043B\u0438 \u043D\u0430\u0439\u0442\u0438 \u0432 \u043C\u0438\u0440\u0435."
  - "\u0416\u0435\u043B\u0430\u044E \u0443\u0434\u0430\u0447\u0438!"
  dialogEnded: 0
