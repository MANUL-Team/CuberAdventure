--- !u!114 &1090671870
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1090671869}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dece018d637e3184b8a152729f8b12bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 1158116266}
  button: {fileID: 1191811763}
  name: {fileID: 953895401}
  text: {fileID: 637498263}
  printText: {fileID: 637498260}
  namesEng:
  - Vitaly
  - Vitaly
  - Vitaly
  - Vitaly
  - Vitaly
  - Vitaly
  dialogTextsEng:
  - Hello! Are you here to buy something?
  - Oh, so you're from Abdul... You don't have enough food? Well, excuse me, we ourselves
    barely have enough...
  - Spiders are stealing our supplies, fields, caterpillars, they are destroying
    everything... I don't know what to do now... It will all be over soon...
  - Listen, you're a Cuber, right? So you should specialize in the extermination
    of mega-insects.
  - "Of course, I understand that spiders are not insects, but it doesn\u2019t change
    the essence, can you kill them for us? They are nothing but trouble!"
  - And for that... I will do my best to make your reputation in Bogograd at its
    best! I will also provide discounts. Deal?
  namesRu:
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  dialogTextsRu:
  - "\u041F\u0440\u0438\u0432\u0435\u0442! \u0422\u044B \u043F\u0440\u0438\u0448\u0435\u043B
    \u0447\u0442\u043E-\u0442\u043E \u043A\u0443\u043F\u0438\u0442\u044C?"
  - "\u041E, \u0442\u0430\u043A \u0442\u044B \u043E\u0442 \u0410\u0431\u0434\u0443\u043B\u0430...
    \u0412\u0430\u043C \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0435\u0434\u044B?
    \u041D\u0443 \u0438\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u043D\u0430\u043C
    \u0441\u0430\u043C\u0438\u043C \u0435\u0434\u0432\u0430 \u0445\u0432\u0430\u0442\u0430\u0435\u0442..."
  - "\u041F\u0430\u0443\u043A\u0438 \u0432\u043E\u0440\u0443\u044E\u0442 \u043D\u0430\u0448\u0438
    \u0437\u0430\u043F\u0430\u0441\u044B, \u043F\u043E\u043B\u044F, \u0433\u0443\u0441\u0435\u043D\u0438\u0446,
    \u043E\u043D\u0438 \u0432\u0441\u0435 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u044E\u0442...
    \u042F \u043D\u0435 \u0437\u043D\u0430\u044E \u0447\u0442\u043E \u043D\u0430\u043C
    \u0434\u0435\u043B\u0430\u0442\u044C \u0442\u0435\u043F\u0435\u0440\u044C...
    \u0421\u043A\u043E\u0440\u043E \u0441\u043E\u0432\u0441\u0435\u043C \u0432\u0441\u0435
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F..."
  - "\u0421\u043B\u0443\u0448\u0430\u0439, \u0430 \u0442\u044B \u0432\u0435\u0434\u044C
    \u043A\u0443\u0431\u0435\u0440, \u0442\u0430\u043A? \u0417\u043D\u0430\u0447\u0438\u0442
    \u0442\u044B \u0438 \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0438
    \u043C\u0435\u0433\u0430\u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445."
  - "\u042F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
    \u0447\u0442\u043E \u043F\u0430\u0443\u043A\u0438 \u044D\u0442\u043E \u043D\u0435
    \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0435, \u043D\u043E \u0441\u0443\u0442\u0438
    \u043D\u0435 \u043C\u0435\u043D\u044F\u0435\u0442, \u0441\u043C\u043E\u0436\u0435\u0448\u044C
    \u0443\u0431\u0438\u0442\u044C \u0438\u0445 \u0434\u043B\u044F \u043D\u0430\u0441?
    \u041E\u0442 \u043D\u0438\u0445 \u043E\u0434\u043D\u0438 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438!"
  - "\u0410 \u0437\u0430 \u044D\u0442\u043E... \u042F \u0441\u0434\u0435\u043B\u0430\u044E
    \u0432\u0441\u0435, \u0447\u0442\u043E\u0431\u044B \u0442\u0432\u043E\u044F \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
    \u0432 \u0411\u043E\u0433\u043E\u043C\u0433\u0440\u0430\u0434\u0435 \u0431\u044B\u043B\u0430
    \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435! \u0410 \u0442\u0430\u043A\u0436\u0435
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0443 \u0441\u043A\u0438\u0434\u043A\u0430\u043C\u0438.
    \u041F\u043E \u0440\u0443\u043A\u0430\u043C?"
  dialogEnded: 0
