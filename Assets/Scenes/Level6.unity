--- !u!114 &1090671870
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1090671869}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dece018d637e3184b8a152729f8b12bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 1158116266}
  button: {fileID: 1191811763}
  name: {fileID: 953895401}
  printText: {fileID: 637498260}
  namesRu:
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - '{playerName}'
  - '{playerName}'
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - '{playerName}'
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  - '{playerName}'
  - "\u0412\u0438\u0442\u0430\u043B\u0438\u0439"
  namesEng:
  - Vitaly
  - '{playerName}'
  - '{playerName}'
  - Vitaly
  - Vitaly
  - '{playerName}'
  - Vitaly
  - Vitaly
  - Vitaly
  - Vitaly
  - '{playerName}'
  - Vitaly
  dialogRu:
  - "\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C. \u0425\u043E\u0442\u0438\u0442\u0435
    \u0447\u0442\u043E-\u0442\u043E \u043A\u0443\u043F\u0438\u0442\u044C?"
  - "\u041D\u0435\u0442. \u042F \u043F\u0440\u0438\u0448\u0435\u043B \u043F\u043E
    \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0432\u043E\u043F\u0440\u043E\u0441\u0443."
  - "\u0410\u0431\u0434\u0443\u043B \u0438\u0437 \u0414\u0435\u0440\u0435\u0432\u043D\u0438
    \u043A\u0443\u0431\u0435\u0440\u043E\u0432 \u0441\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B\u0438
    \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0442\u043E\u0432\u0430\u0440\u043E\u0432.
    \u0427\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E?"
  - "\u0410\u0445 \u043E\u0431 \u044D\u0442\u043E\u043C..."
  - "\u041D\u0430\u0448\u0438 \u043F\u043E\u043B\u044F \u0440\u0430\u0437\u043E\u0440\u0435\u043D\u044B..."
  - "\u041D\u043E \u043F\u043E\u0447\u0435\u043C\u0443?"
  - "\u041F\u0430\u0443\u043A\u0438..."
  - "\u041E\u043D\u0438 \u0433\u0440\u0430\u0431\u044F\u0442 \u043D\u0430\u0441,
    \u0430 \u043C\u044B \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u043C
    \u0438\u043C \u0441\u0434\u0435\u043B\u0430\u0442\u044C..."
  - "\u041E\u043D\u0438 \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0441\u0438\u043B\u044C\u043D\u0435\u0435
    \u043D\u0430\u0441..."
  - "\u041A\u0443\u0431\u0435\u0440... \u041F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u044F
    \u043E \u043F\u043E\u043C\u043E\u0449\u0438..."
  - "\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 {playerName}. \u0425\u043E\u0440\u043E\u0448\u043E,
    \u044F \u0432\u0430\u043C \u043F\u043E\u043C\u043E\u0433\u0443"
  - "\u041E\u0433\u0440\u043E\u043C\u043D\u043E\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u043E,
    {playerName}! \u042F \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0443 \u0442\u0432\u043E\u0435\u0433\u043E
    \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u0430!"
  dialogEng:
  - Good afternoon. Do you want to buy something?
  - No. I came on another issue.
  - Abdul from Kuber Village said that you have stopped supplying goods. What happened?
  - Oh about that...
  - Our fields are devastated...
  - But why?
  - Spiders...
  - They rob us, but we can't do anything to them...
  - They are much stronger than us...
  - Cuber... I ask you for help...
  - My name is {playerName}. Okay, I'll help you
  - Thank you so much, {playerName}! I will not forget your deed!
  dialogEnded: 0
