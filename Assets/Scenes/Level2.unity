  m_Script: {fileID: 11500000, guid: dece018d637e3184b8a152729f8b12bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 1177414110}
  button: {fileID: 1742541358}
  name: {fileID: 946703591}
  text: {fileID: 1421912249}
  printText: {fileID: 1421912246}
  namesEng:
  - The inner voice
  - The inner voice
  dialogTextsEng:
  - Shh... See, there's a mantis standing on top? This is a hostile mob, it will
    attack you!
  - You're too weak right now, better jump over it.
  namesRu:
  - "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0433\u043E\u043B\u043E\u0441"
  - "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0433\u043E\u043B\u043E\u0441"
  dialogTextsRu:
  - "\u0422\u0441\u0441... \u0412\u0438\u0434\u0438\u0448\u044C, \u0442\u0430\u043C
    \u0441\u0432\u0435\u0440\u0445\u0443 \u0441\u0442\u043E\u0438\u0442 \u0431\u043E\u0433\u043E\u043C\u043E\u043B?
    \u042D\u0442\u043E \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043D\u044B\u0439
    \u043C\u043E\u0431, \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u0442\u0435\u0431\u044F
    \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C!"
  - "\u0421\u0435\u0439\u0447\u0430\u0441 \u0442\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0441\u043B\u0430\u0431\u044B\u0439, \u043B\u0443\u0447\u0448\u0435 \u043F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u043D\u0438
    \u0435\u0433\u043E."
  dialogEnded: 0
