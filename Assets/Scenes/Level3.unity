    - target: {fileID: 7603313533023696501, guid: 71e78c9cf1856eb4485bcbf78b0c1353, type: 3}
      propertyPath: namesRu.Array.data[4]
      value: "\u0414\u044D\u043D630"
      objectReference: {fileID: 0}
    - target: {fileID: 7603313533023696501, guid: 71e78c9cf1856eb4485bcbf78b0c1353, type: 3}
      propertyPath: namesEng.Array.data[4]
      value: Dan630
      objectReference: {fileID: 0}
    - target: {fileID: 7603313533023696501, guid: 71e78c9cf1856eb4485bcbf78b0c1353, type: 3}
      propertyPath: dialogTextsRu.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7603313533023696501, guid: 71e78c9cf1856eb4485bcbf78b0c1353, type: 3}
      propertyPath: dialogTextsEng.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7603313533023696501, guid: 71e78c9cf1856eb4485bcbf78b0c1353, type: 3}
      propertyPath: dialogTextsRu.Array.data[2]
      value: "\u041D\u043E \u0443\u0447\u0442\u0438, \u0447\u0442\u043E \u0434\u043B\u044F
        \u043A\u0440\u0430\u0444\u0442\u0430 \u0442\u0435\u0431\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F
        \u0440\u0435\u0441\u0443\u0440\u0441\u044B. \u0418\u0445 \u043C\u043E\u0436\u043D\u043E
        \u043A\u0443\u043F\u0438\u0442\u044C \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435
        \u0438\u043B\u0438 \u043D\u0430\u0439\u0442\u0438 \u0432 \u043C\u0438\u0440\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 7603313533023696501, guid: 71e78c9cf1856eb4485bcbf78b0c1353, type: 3}
      propertyPath: dialogTextsRu.Array.data[3]
      value: "\u0418\u0434\u0438 \u043A \u0410\u0431\u0434\u0443\u043B\u0443, \u043E\u043D
        \u043D\u0430\u0448 \u043F\u0440\u043E\u0434\u0430\u0432\u0435\u0446. \u0422\u044B
        \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u0439\u0442\u0438 \u0435\u0433\u043E
        \u0432\u043E\u0437\u043B\u0435 \u043D\u0430\u043A\u043E\u0432\u0430\u043B\u044C\u043D\u0438.
        \u0423 \u043D\u0435\u0433\u043E \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
        \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u044B
        \u0434\u043B\u044F \u043A\u0440\u0430\u0444\u0442\u0430 \u0438, \u0435\u0441\u043B\u0438
        \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0434\u0435\u043D\u0435\u0433,
        \u043A\u0443\u043F\u0438\u0442\u044C \u0438\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 7603313533023696501, guid: 71e78c9cf1856eb4485bcbf78b0c1353, type: 3}
      propertyPath: dialogTextsRu.Array.data[4]
      value: "\u0416\u0435\u043B\u0430\u044E \u0443\u0434\u0430\u0447\u0438!"
      objectReference: {fileID: 0}
    - target: {fileID: 7603313533023696501, guid: 71e78c9cf1856eb4485bcbf78b0c1353, type: 3}
      propertyPath: dialogTextsEng.Array.data[3]
      value: Go to Abdul, he's our salesman. You can find him by the anvil. You can
        look at crafting resources from him and, if you have enough money, buy them.
      objectReference: {fileID: 0}
    - target: {fileID: 7603313533023696501, guid: 71e78c9cf1856eb4485bcbf78b0c1353, type: 3}
      propertyPath: dialogTextsEng.Array.data[4]
      value: Good luck!
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 71e78c9cf1856eb4485bcbf78b0c1353, type: 3}
