--- !u!114 &767653584
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 767653582}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dece018d637e3184b8a152729f8b12bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 544963502}
  button: {fileID: 963990768}
  name: {fileID: 56514870}
  text: {fileID: 1741054364}
  printText: {fileID: 1741054361}
  namesEng:
  - Abdul
  - Abdul
  - Abdul
  dialogTextsEng:
  - Hello again! Listen, do you have a spare minute? I wanted to ask you to go to
    the neighboring town, Mantitown.
  - There you will find my colleague, merchant Vitaly. Please tell him that our village
    is short of food supplies.
  - Thank you!
  namesRu:
  - "\u0410\u0431\u0434\u0443\u043B"
  - "\u0410\u0431\u0434\u0443\u043B"
  - "\u0410\u0431\u0434\u0443\u043B"
  dialogTextsRu:
  - "\u0418 \u0441\u043D\u043E\u0432\u0430 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439!
    \u0421\u043B\u0443\u0448\u0430\u0439, \u0430 \u0443 \u0442\u0435\u0431\u044F
    \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u0442\u0441\u044F \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0439
    \u043C\u0438\u043D\u0443\u0442\u043A\u0438? \u042F \u0445\u043E\u0442\u0435\u043B
    \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0442\u0435\u0431\u044F
    \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0439
    \u0433\u043E\u0440\u043E\u0434, \u0411\u043E\u0433\u043E\u043C\u0433\u0440\u0430\u0434."
  - "\u0422\u0430\u043C \u0442\u044B \u043D\u0430\u0439\u0434\u0435\u0448\u044C \u043C\u043E\u0435\u0433\u043E
    \u043A\u043E\u043B\u043B\u0435\u0433\u0443, \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430
    \u0412\u0438\u0442\u0430\u043B\u0438\u044F. \u041F\u0435\u0440\u0435\u0434\u0430\u0439
    \u0435\u043C\u0443 \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
    \u0447\u0442\u043E \u043D\u0430\u0448\u0435\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0435
    \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043F\u043E\u0441\u0442\u0430\u0432\u043E\u043A
    \u043F\u0440\u043E\u0434\u043E\u0432\u043B\u044C\u0441\u0442\u0432\u0438\u044F."
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
  dialogEnded: 0
