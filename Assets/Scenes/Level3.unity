--- !u!114 &1727103024
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1727103022}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dece018d637e3184b8a152729f8b12bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 1246590394}
  button: {fileID: 1197056011}
  name: {fileID: 306252496}
  text: {fileID: 1410876499}
  printText: {fileID: 1410876496}
  namesEng:
  - Abdul
  - Abdul
  dialogTextsEng:
  - Oh, hi, I haven't seen you here before. Did Dan630 send you here? I asked him
    to send all the newly sent to me.
  - So you need to buy something for crafting, right? Let's see what I have for you...
  namesRu:
  - "\u0410\u0431\u0434\u0443\u043B"
  - "\u0410\u0431\u0434\u0443\u043B"
  dialogTextsRu:
  - "\u041E\u0443, \u043F\u0440\u0438\u0432\u0435\u0442, \u044F \u0442\u0435\u0431\u044F
    \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0435
    \u0432\u0438\u0434\u0435\u043B. \u0422\u0435\u0431\u044F \u0441\u044E\u0434\u0430
    \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B \u0414\u044D\u043D630? \u042F
    \u043F\u0440\u043E\u0441\u0438\u043B \u0435\u0433\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
    \u043A\u043E \u043C\u043D\u0435 \u0432\u0441\u0435\u0445 \u043D\u043E\u0432\u043E\u0437\u0430\u0441\u043B\u0430\u043D\u043D\u044B\u0445."
  - "\u0422\u0430\u043A \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0447\u0442\u043E-\u0442\u043E
    \u043A\u0443\u043F\u0438\u0442\u044C \u0434\u043B\u044F \u043A\u0440\u0430\u0444\u0442\u043E\u0432,
    \u0442\u0430\u043A? \u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
    \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0434\u043B\u044F \u0442\u0435\u0431\u044F
    \u0435\u0441\u0442\u044C..."
  dialogEnded: 0
