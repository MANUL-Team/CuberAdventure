--- !u!114 &1023882383
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1023882381}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dece018d637e3184b8a152729f8b12bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 271549667}
  button: {fileID: 1184261998}
  name: {fileID: 737017276}
  text: {fileID: 870270651}
  printText: {fileID: 870270648}
  namesEng:
  - I
  - Abdul
  - Abdul
  - I
  - Abdul
  - Abdul
  - Abdul
  dialogTextsEng:
  - Hi! I conveyed your words to Vitaly. It turns out that they themselves do not
    have enough food. Spiders destroy their fields and livestock.
  - What a horror... But there's nothing we can do... Everyone in our village is
    a cuber of old models and does not support powerful modules.
  - Increasingly strong Kubera have long gone further inland. And we are standing
    in this village to receive recruits.
  - Check me out!
  - Amazing! You support any modules!
  - In this case, only you are able to destroy the den of spiders and save Bogomgrad.
    You need to craft powerful modules for this!
  - You can collect resources for modules in a Suburban meadow and in a Spider's
    Den.
  namesRu:
  - "\u042F"
  - "\u0410\u0431\u0434\u0443\u043B"
  - "\u0410\u0431\u0434\u0443\u043B"
  - "\u042F"
  - "\u0410\u0431\u0434\u0443\u043B"
  - "\u0410\u0431\u0434\u0443\u043B"
  - "\u0410\u0431\u0434\u0443\u043B"
  dialogTextsRu:
  - "\u041F\u0440\u0438\u0432\u0435\u0442! \u042F \u043F\u0435\u0440\u0435\u0434\u0430\u043B
    \u0442\u0432\u043E\u0438 \u0441\u043B\u043E\u0432\u0430 \u0412\u0438\u0442\u0430\u043B\u0438\u044E.
    \u041E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0443 \u043D\u0438\u0445
    \u0443 \u0441\u0430\u043C\u0438\u0445 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
    \u043F\u0440\u043E\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F.
    \u041F\u0430\u0443\u043A\u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u044E\u0442
    \u0438\u0445 \u043F\u043E\u043B\u044F \u0438 \u0441\u043A\u043E\u0442."
  - "\u041A\u0430\u043A\u043E\u0439 \u0443\u0436\u0430\u0441... \u041D\u043E \u043C\u044B
    \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u043C
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C... \u0412\u0441\u0435 \u0432 \u043D\u0430\u0448\u0435\u0439
    \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043A\u0443\u0431\u0435\u0440\u044B
    \u0441\u0442\u0430\u0440\u044B\u0445 \u043C\u043E\u0434\u0435\u043B\u0435\u0439
    \u0438 \u043D\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043C
    \u043C\u043E\u0449\u043D\u044B\u0435 \u043C\u043E\u0434\u0443\u043B\u0438."
  - "\u0412\u0441\u0435 \u0431\u043E\u043B\u0435\u0435 \u0441\u0438\u043B\u044C\u043D\u044B\u0435
    \u043A\u0443\u0431\u0435\u0440\u044B \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E
    \u043F\u0440\u043E\u0448\u043B\u0438 \u0434\u0430\u043B\u044C\u0448\u0435 \u0432\u0433\u043B\u0443\u0431\u044C
    \u043C\u0430\u0442\u0435\u0440\u0438\u043A\u0430. \u0410 \u043C\u044B \u0441\u0442\u043E\u0438\u043C
    \u0432 \u044D\u0442\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0435, \u0447\u0442\u043E\u0431\u044B
    \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u043D\u043E\u0432\u043E\u0431\u0440\u0430\u043D\u0446\u0435\u0432."
  - "\u0410 \u043F\u0440\u043E\u0432\u0435\u0440\u044C \u043C\u0435\u043D\u044F!"
  - "\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E! \u0422\u044B
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0448\u044C
    \u043B\u044E\u0431\u044B\u0435 \u043C\u043E\u0434\u0443\u043B\u0438!"
  - "\u0412 \u0442\u0430\u043A\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0442\u044B \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
    \u043B\u043E\u0433\u043E\u0432\u043E \u043F\u0430\u0443\u043A\u043E\u0432 \u0438
    \u0441\u043F\u0430\u0441\u0442\u0438 \u0411\u043E\u0433\u043E\u043C\u0433\u0440\u0430\u0434.
    \u0422\u0435\u0431\u0435 \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043D\u0443\u0436\u043D\u043E
    \u0441\u043A\u0440\u0430\u0444\u0442\u0438\u0442\u044C \u043C\u043E\u0449\u043D\u044B\u0435
    \u043C\u043E\u0434\u0443\u043B\u0438!"
  - "\u0420\u0435\u0441\u0443\u0440\u0441\u044B \u0434\u043B\u044F \u043C\u043E\u0434\u0443\u043B\u0435\u0439
    \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    \u043D\u0430 \u041F\u0440\u0438\u0433\u043E\u0440\u043E\u0434\u043D\u043E\u043C
    \u043B\u0443\u0433\u0443 \u0438 \u0432 \u041F\u0430\u0443\u0447\u044C\u0435\u043C
    \u043B\u043E\u0433\u043E\u0432\u0435."
  dialogEnded: 0
