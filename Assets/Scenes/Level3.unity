  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 9195925047210470592}
  button: {fileID: 4710919736597078695}
  name: {fileID: 7655602269128045697}
  text: {fileID: 7425659266395550252}
  printText: {fileID: 1632144794451878154}
  namesEng:
  - Abdul
  - Abdul
  dialogTextsEng:
  - Listen, I recently received a new delivery of goods from behind the wall, are
    you interested?
  - Come again!
  namesRu:
  - "\u0410\u0431\u0434\u0443\u043B"
  - "\u0410\u0431\u0434\u0443\u043B"
  dialogTextsRu:
  - "\u0421\u043B\u0443\u0448\u0430\u0439, \u043C\u043D\u0435 \u043D\u0435\u0434\u0430\u0432\u043D\u043E
    \u043F\u0440\u0438\u0448\u043B\u0430 \u043D\u043E\u0432\u0430\u044F \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0430
    \u0442\u043E\u0432\u0430\u0440\u0430 \u0438\u0437-\u0437\u0430 \u0441\u0442\u0435\u043D\u044B,
    \u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442?"
  - "\u041F\u0440\u0438\u0445\u043E\u0434\u0438 \u0435\u0449\u0435!"
  dialogEnded: 0
