      objectReference: {fileID: 0}
    - target: {fileID: 1685464763887809082, guid: 8d75d8ec05784ea488d2391948827b96, type: 3}
      propertyPath: namesEng.Array.data[2]
      value: The Spider Admiral
      objectReference: {fileID: 0}
    - target: {fileID: 1685464763887809082, guid: 8d75d8ec05784ea488d2391948827b96, type: 3}
      propertyPath: dialogTextsRu.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 1685464763887809082, guid: 8d75d8ec05784ea488d2391948827b96, type: 3}
      propertyPath: dialogTextsEng.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 1685464763887809082, guid: 8d75d8ec05784ea488d2391948827b96, type: 3}
      propertyPath: dialogTextsRu.Array.data[0]
      value: "\u0425\u0430-\u0445\u0430! \u0422\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0448\u044C
        \u043D\u0430\u0441 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C!
        \u041C\u044B, \u043F\u0430\u0443\u043A\u0438, \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0435
        \u0432 \u044D\u0442\u043E\u043C \u043C\u0438\u0440\u0435, \u043C\u044B \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u0435\u0439\u0448\u0438\u0435
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430!"
      objectReference: {fileID: 0}
    - target: {fileID: 1685464763887809082, guid: 8d75d8ec05784ea488d2391948827b96, type: 3}
      propertyPath: dialogTextsRu.Array.data[1]
      value: "\u041D\u0443 \u0443\u0436 \u043D\u0435\u0442, \u044F \u0443\u0431\u044C\u044E
        \u0442\u0435\u0431\u044F \u0438 \u0432\u0441\u0435\u0445 \u0442\u0432\u043E\u0438\u0445
        \u043F\u043E\u0434\u0434\u0430\u043D\u043D\u044B\u0445!"
      objectReference: {fileID: 0}
    - target: {fileID: 1685464763887809082, guid: 8d75d8ec05784ea488d2391948827b96, type: 3}
      propertyPath: dialogTextsRu.Array.data[2]
      value: "\u0414\u0430\u0432\u0430\u0439 \u0436\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
        \u0442\u0432\u043E\u0438 \u0441\u0438\u043B\u044B!"
      objectReference: {fileID: 0}
    - target: {fileID: 1685464763887809082, guid: 8d75d8ec05784ea488d2391948827b96, type: 3}
      propertyPath: dialogTextsEng.Array.data[0]
      value: Ha ha! You can't destroy us! We spiders are the strongest in this world,
        we are the most perfect creatures!
      objectReference: {fileID: 0}
    - target: {fileID: 1685464763887809082, guid: 8d75d8ec05784ea488d2391948827b96, type: 3}
      propertyPath: dialogTextsEng.Array.data[1]
      value: Well, no, I will kill you and all your subjects!
      objectReference: {fileID: 0}
    - target: {fileID: 1685464763887809082, guid: 8d75d8ec05784ea488d2391948827b96, type: 3}
      propertyPath: dialogTextsEng.Array.data[2]
      value: Let's test your strength!
      objectReference: {fileID: 0}
