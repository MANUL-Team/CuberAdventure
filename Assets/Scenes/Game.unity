--- !u!114 &1726552145
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1726552143}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dece018d637e3184b8a152729f8b12bd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 1841188290}
  button: {fileID: 679544674}
  name: {fileID: 375339244}
  text: {fileID: 152085594}
  printText: {fileID: 152085591}
  namesEng:
  - The inner voice
  - The inner voice
  - The inner voice
  dialogTextsEng:
  - Hi! I am your built-in assistant and now I will instruct you!
  - To jump, press the big button on the bottom right, it shows a jumping cuber.
  - You can make extra jumps. Their number depends on the installed turbines.
  namesRu:
  - "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0433\u043E\u043B\u043E\u0441"
  - "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0433\u043E\u043B\u043E\u0441"
  - "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0433\u043E\u043B\u043E\u0441"
  dialogTextsRu:
  - "\u041F\u0440\u0438\u0432\u0435\u0442! \u042F \u0442\u0432\u043E\u0439 \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439
    \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0438 \u0441\u0435\u0439\u0447\u0430\u0441
    \u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0443 \u0442\u0435\u0431\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436!"
  - "\u0427\u0442\u043E\u0431\u044B \u043F\u0440\u044B\u0433\u0430\u0442\u044C \u043D\u0430\u0436\u043C\u0438
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443
    \u0441\u043F\u0440\u0430\u0432\u0430 \u0441\u043D\u0438\u0437\u0443, \u043D\u0430
    \u043D\u0435\u0439 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D \u043F\u0440\u044B\u0433\u0430\u044E\u0449\u0438\u0439
    \u043A\u0443\u0431\u0435\u0440."
  - "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0442\u044C
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u043F\u0440\u044B\u0436\u043A\u0438. \u0418\u0445 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0445
    \u0442\u0443\u0440\u0431\u0438\u043D."
  dialogEnded: 0
