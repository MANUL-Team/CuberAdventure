  m_Name: 
  m_EditorClassIdentifier: 
  dialog: {fileID: 1249583008}
  button: {fileID: 1515674885}
  name: {fileID: 1947127225}
  text: {fileID: 488098679}
  printText: {fileID: 488098676}
  namesEng:
  - The inner voice
  dialogTextsEng:
  - You got it right, these are coins! You can buy various resources for them, so
    try not to miss them!
  namesRu:
  - "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0433\u043E\u043B\u043E\u0441"
  dialogTextsRu:
  - "\u0422\u044B \u0432\u0441\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
    \u043F\u043E\u043D\u044F\u043B, \u044D\u0442\u043E \u043C\u043E\u043D\u0435\u0442\u044B!
    \u0417\u0430 \u043D\u0438\u0445 \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442
    \u043A\u0443\u043F\u0438\u0442\u044C \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435
    \u0440\u0435\u0441\u0443\u0440\u0441\u044B, \u0442\u0430\u043A \u0447\u0442\u043E
    \u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u043D\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C
    \u0438\u0445!"
  dialogEnded: 0
